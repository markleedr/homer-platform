# 1Password reference file for local development (used by `make dev`).
#
# This file contains NO secret values, only op:// references that the 1Password
# CLI resolves at runtime. It is safe to commit. Requires the 1Password CLI (op)
# signed in and the referenced item in your vault (see README "Running locally").
#
# The app's Supabase values are client-safe (public by design; RLS is the real
# protection), but they are sourced here so a new machine runs `make dev` with no
# manual .env setup, and so the real server secrets for the AI gateway (P0.16)
# slot into this same flow.
#
# Adjust the vault and item names below to match your own vault if they differ.

VITE_PRODUCT_NAME=Homer

# Local dev points at homer-staging (the same project PR previews use).
VITE_SUPABASE_URL=op://Homer/homer-staging/supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=op://Homer/homer-staging/supabase_publishable_key

# Auth bypass stays off by default (see app/src/config.ts). Set to "true" locally
# only if you want to skip the magic-link sign-in while iterating on the shell.
VITE_AUTH_BYPASS=false
