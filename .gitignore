# Dependencies
node_modules/

# Build output
dist/
build/

# Environment and secrets (never commit; managed per environment)
.env
.env.*
!.env.example
# .env.op holds only 1Password op:// references, no secret values, so it is
# tracked. Real values live in your vault and are injected by `op run`.
!.env.op

# Vercel
.vercel/

# Supabase CLI working directory. Canonical migrations and tests live in /db;
# the CLI scaffold is generated in CI (supabase init) and never committed.
/supabase/

# Logs
*.log
npm-debug.log*

# Editor and OS
.DS_Store
.idea/
.vscode/
*.swp
