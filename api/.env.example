# Server-side environment for the serverless functions in /api (the AI gateway).
# Copy to .env.local for local development. Never commit real values.
#
# NOTHING here is prefixed VITE_. These values are read only by server-side
# functions and must never reach the browser or the repo. See
# docs/infrastructure.md for the full rule.
#
# No function exists yet: these land when the AI gateway is built (P0.16).

# Supabase, server side. The URL matches the client one; the service-role key
# is a SECRET that bypasses row-level security, so it is server-only and is
# copied from the Supabase dashboard, never committed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The platform Anthropic API key is NOT set here. It lives in Supabase Vault
# (encrypted, server-side, per CLAUDE.md rule 3) and is added at P0.16 alongside
# the gateway that reads and validates it. Per-org and per-user BYO keys also
# live in Vault, per tenant.
