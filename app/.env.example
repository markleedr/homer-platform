# Copy to .env.local for local development. Never commit real values.
#
# Everything here is prefixed VITE_ and is therefore compiled into the browser
# bundle. It is PUBLIC. Only ever put client-safe values here: never a secret,
# never a service-role key, never an AI key. See docs/infrastructure.md.

# Product working name. Overrides the "Homer" placeholder default.
VITE_PRODUCT_NAME=Homer

# Supabase project the app talks to. Client-safe: the URL and the publishable
# key are designed to be public; row-level security is the real protection.
# Per environment: production uses homer-production, previews use homer-staging.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
